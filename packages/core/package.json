{
  "name": "@git-forecast/core",
  "version": "0.0.0",
  "description": "The engine behind git-forecast: reads a repo and forecasts what Git will do, as plain data",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khattakdev/git-forecast.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  }
}
