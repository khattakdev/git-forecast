{
  "name": "@git-forecast/core",
  "version": "0.1.0",
  "description": "The engine behind git-forecast: reads a repo and forecasts what Git will do, as plain data",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE','LICENSE')\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khattakdev/git-forecast.git",
    "directory": "packages/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "git",
    "merge-tree",
    "rebase",
    "merge",
    "conflicts"
  ]
}
